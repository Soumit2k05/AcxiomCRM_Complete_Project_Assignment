@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div class="row justify-content-center align-items-center py-5">
    <div class="col-12 col-md-6 col-lg-5 text-center">
        <div class="crm-card p-5">
            <div class="text-danger display-1 mb-3">
                <i class="bi bi-shield-x"></i>
            </div>
            <h2 class="fw-bold mb-2">Access Denied</h2>
            <p class="text-muted mb-4">
                You do not have permission to access this resource or administrative module under your current role assignment.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-house me-1"></i> Return to Dashboard
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-repeat me-1"></i> Switch Account
                </a>
            </div>
        </div>
    </div>
</div>
