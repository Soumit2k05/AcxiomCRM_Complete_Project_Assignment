@model AcxiomCRM.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "_Layout";
}

<div class="row justify-content-center align-items-center py-4">
    <div class="col-12 col-md-8 col-lg-5 col-xl-4">
        <div class="crm-card shadow-sm border-0">
            <div class="crm-card-header bg-white border-bottom py-3 text-center d-block">
                <div class="brand-icon mx-auto mb-2 text-primary fs-3">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <h4 class="fw-bold mb-1">AcxiomCRM Sign In</h4>
                <p class="text-muted small mb-0">Secure role-based enterprise access</p>
            </div>
            <div class="crm-card-body p-4">
                <form asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" id="loginForm">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" id="emailInput" placeholder="name@company.com" autocomplete="username" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-semibold text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" class="form-control" id="passwordInput" placeholder="••••••••" autocomplete="current-password" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" id="rememberMeCheck" />
                            <label asp-for="RememberMe" class="form-check-label small text-muted" for="rememberMeCheck"></label>
                        </div>
                        <span class="small text-muted">Lockout: 5 attempts</span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm mb-3">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to CRM
                    </button>

                    <div class="text-center small text-muted">
                        Need an account? <a asp-controller="Account" asp-action="Register" class="text-primary text-decoration-none fw-semibold">Register here</a>
                    </div>
                </form>

                <!-- Quick Seed Test Accounts for Rapid Evaluation -->
                <div class="mt-4 pt-3 border-top">
                    <div class="text-muted small fw-semibold mb-2 text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">
                        Quick Test Accounts (Click to Fill)
                    </div>
                    <div class="d-flex flex-column gap-2">
                        <div class="quick-login-chip d-flex justify-content-between align-items-center" onclick="fillCreds('admin@acxiomcrm.local', 'Admin@12345!')">
                            <div>
                                <span class="badge bg-danger me-1">Admin</span>
                                <code>admin@acxiomcrm.local</code>
                            </div>
                            <span class="text-primary small"><i class="bi bi-box-arrow-in-right"></i></span>
                        </div>
                        <div class="quick-login-chip d-flex justify-content-between align-items-center" onclick="fillCreds('manager@acxiomcrm.local', 'Manager@12345!')">
                            <div>
                                <span class="badge bg-primary me-1">Manager</span>
                                <code>manager@acxiomcrm.local</code>
                            </div>
                            <span class="text-primary small"><i class="bi bi-box-arrow-in-right"></i></span>
                        </div>
                        <div class="quick-login-chip d-flex justify-content-between align-items-center" onclick="fillCreds('sales@acxiomcrm.local', 'Sales@12345!')">
                            <div>
                                <span class="badge bg-success me-1">Sales</span>
                                <code>sales@acxiomcrm.local</code>
                            </div>
                            <span class="text-primary small"><i class="bi bi-box-arrow-in-right"></i></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillCreds(email, password) {
            document.getElementById('emailInput').value = email;
            document.getElementById('passwordInput').value = password;
        }
    </script>
}
