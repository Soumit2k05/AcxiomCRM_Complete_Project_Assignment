@model IEnumerable<AcxiomCRM.Models.Activity>
@{
    ViewData["Title"] = "Activity Log";
    var currentType = ViewData["CurrentType"] as string;
    var currentStatus = ViewData["CurrentStatus"] as string;
    var currentSearch = ViewData["CurrentSearch"] as string;
}

<div class="container-fluid px-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-activity text-danger me-2"></i> Activity Management
            </h1>
            <p class="text-muted mb-0 small">
                Client calls, conference meetings, communications, and customer interactions.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary rounded-pill btn-sm px-3 shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Log Activity
            </a>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="crm-card mb-4">
        <div class="crm-card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-12 col-md-5">
                    <input type="text" name="search" class="form-control rounded-pill px-3" placeholder="Search subject, description..." value="@currentSearch" />
                </div>
                <div class="col-6 col-md-3">
                    <select name="type" class="form-select rounded-pill">
                        <option value="">All Activity Types</option>
                        <option value="Call" selected="@(currentType == "Call")">Call</option>
                        <option value="Meeting" selected="@(currentType == "Meeting")">Meeting</option>
                        <option value="Email" selected="@(currentType == "Email")">Email</option>
                        <option value="Task" selected="@(currentType == "Task")">Task</option>
                    </select>
                </div>
                <div class="col-6 col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary rounded-pill px-4 flex-grow-1">Filter</button>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Table Card -->
    <div class="crm-card">
        <div class="crm-card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th>Type</th>
                            <th>Subject &amp; Details</th>
                            <th>Related To</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Logged By</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-activity fs-2 d-block mb-2 text-secondary"></i>
                                    No activities recorded.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="badge rounded-pill bg-light text-dark border">
                                            @if (item.ActivityType == "Call") { <i class="bi bi-telephone text-primary me-1"></i> }
                                            else if (item.ActivityType == "Meeting") { <i class="bi bi-people text-success me-1"></i> }
                                            else if (item.ActivityType == "Email") { <i class="bi bi-envelope text-info me-1"></i> }
                                            else { <i class="bi bi-check2-square text-secondary me-1"></i> }
                                            @item.ActivityType
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.Subject</div>
                                        @if (!string.IsNullOrEmpty(item.Description))
                                        {
                                            <div class="small text-muted text-truncate" style="max-width: 350px;">@item.Description</div>
                                        }
                                    </td>
                                    <td>
                                        @if (item.Customer != null)
                                        {
                                            <a asp-controller="Customers" asp-action="Details" asp-route-id="@item.CustomerId" class="text-decoration-none small text-dark fw-semibold">
                                                <i class="bi bi-building me-1 text-primary"></i>@item.Customer.CustomerName
                                            </a>
                                        }
                                        else if (item.Lead != null)
                                        {
                                            <a asp-controller="Leads" asp-action="Details" asp-route-id="@item.LeadId" class="text-decoration-none small text-info">
                                                <i class="bi bi-funnel me-1"></i>@item.Lead.LeadName
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="small text-muted">General</span>
                                        }
                                    </td>
                                    <td class="small text-muted">
                                        @item.ActivityDate.ToString("yyyy-MM-dd HH:mm")
                                    </td>
                                    <td>
                                        <span class="badge rounded-pill @(item.Status == "Completed" ? "bg-success bg-opacity-10 text-success border border-success" : "bg-secondary bg-opacity-10 text-secondary border border-secondary")">
                                            @item.Status
                                        </span>
                                    </td>
                                    <td class="small text-muted">
                                        @(item.AssignedTo ?? "System")
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
