@model IEnumerable<AcxiomCRM.Models.AuditLog>
@{
    ViewData["Title"] = "Audit Trail & Security Logs";
    var currentUserFilter = ViewData["CurrentUserFilter"] as string;
    var currentModuleFilter = ViewData["CurrentModuleFilter"] as string;
    var currentActionFilter = ViewData["CurrentActionFilter"] as string;
    var startDate = ViewData["StartDate"] as string;
    var endDate = ViewData["EndDate"] as string;
    var currentPage = (int)(ViewData["CurrentPage"] ?? 1);
    var totalPages = (int)(ViewData["TotalPages"] ?? 1);
    var totalItems = (int)(ViewData["TotalItems"] ?? 0);
}

<div class="container-fluid px-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-journal-text text-warning me-2"></i> Audit Trail &amp; Compliance Log
            </h1>
            <p class="text-muted mb-0 small">
                Append-only forensic log recording authentication, security changes, entity mutations, and operational activities.
            </p>
        </div>
        <div class="d-flex gap-2">
            <span class="badge rounded-pill bg-light text-dark border px-3 py-2">
                <i class="bi bi-shield-lock-fill text-success me-1"></i> Tamper-Protected (Append-Only)
            </span>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="crm-card mb-4">
        <div class="crm-card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-12 col-md-3">
                    <input type="text" name="userFilter" class="form-control form-control-sm rounded-pill px-3" placeholder="Filter by User / Email..." value="@currentUserFilter" />
                </div>
                <div class="col-6 col-md-2">
                    <select name="moduleFilter" class="form-select form-select-sm rounded-pill">
                        <option value="">All Modules</option>
                        @foreach (var mod in (IEnumerable<string>)ViewBag.Modules)
                        {
                            <option value="@mod" selected="@(currentModuleFilter == mod)">@mod</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <select name="actionFilter" class="form-select form-select-sm rounded-pill">
                        <option value="">All Actions</option>
                        @foreach (var act in (IEnumerable<string>)ViewBag.Actions)
                        {
                            <option value="@act" selected="@(currentActionFilter == act)">@act</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <input type="date" name="startDate" class="form-control form-control-sm rounded-pill" value="@startDate" title="Start Date" />
                </div>
                <div class="col-6 col-md-2">
                    <input type="date" name="endDate" class="form-control form-control-sm rounded-pill" value="@endDate" title="End Date" />
                </div>
                <div class="col-12 col-md-1 d-flex gap-1">
                    <button type="submit" class="btn btn-primary rounded-pill btn-sm w-100"><i class="bi bi-funnel"></i></button>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Audit Log Table -->
    <div class="crm-card">
        <div class="crm-card-header d-flex justify-content-between align-items-center">
            <div class="crm-card-title">
                Recorded Audit Entries <span class="badge bg-light text-dark border ms-2">@totalItems Total</span>
            </div>
        </div>
        <div class="crm-card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 font-monospace small">
                    <thead class="table-light text-muted small text-uppercase font-sans">
                        <tr>
                            <th>Timestamp</th>
                            <th>User</th>
                            <th>Action</th>
                            <th>Module</th>
                            <th>Record ID</th>
                            <th>Result</th>
                            <th>IP Address</th>
                            <th class="text-end font-sans">Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted font-sans">
                                    <i class="bi bi-journal fs-2 d-block mb-2 text-secondary"></i>
                                    No audit records found matching the filter criteria.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var log in Model)
                            {
                                <tr>
                                    <td class="text-muted">
                                        @log.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")
                                    </td>
                                    <td class="fw-bold text-dark font-sans">
                                        @(log.UserId ?? "Anonymous")
                                    </td>
                                    <td>
                                        @{
                                            var actBadge = log.Action switch
                                            {
                                                "Create" => "bg-success bg-opacity-10 text-success border border-success",
                                                "Update" => "bg-primary bg-opacity-10 text-primary border border-primary",
                                                "Delete" => "bg-danger bg-opacity-10 text-danger border border-danger",
                                                "Login" => "bg-info bg-opacity-10 text-info border border-info",
                                                "Failed Login" => "bg-danger text-white",
                                                "Lockout" => "bg-dark text-white",
                                                "Conversion" => "bg-purple text-white",
                                                _ => "bg-secondary bg-opacity-10 text-secondary border"
                                            };
                                        }
                                        <span class="badge rounded-pill @actBadge font-sans">@log.Action</span>
                                    </td>
                                    <td class="fw-semibold text-secondary font-sans">
                                        @log.EntityName
                                    </td>
                                    <td>
                                        @(log.RecordId ?? "-")
                                    </td>
                                    <td>
                                        <span class="badge rounded-pill @(log.Result == "Success" ? "bg-success" : "bg-danger") font-sans" style="font-size: 0.65rem;">
                                            @log.Result
                                        </span>
                                    </td>
                                    <td class="text-muted">
                                        @(log.IpAddress ?? "127.0.0.1")
                                    </td>
                                    <td class="text-end font-sans">
                                        <a asp-action="Details" asp-route-id="@log.AuditLogId" class="btn btn-outline-secondary btn-sm rounded-pill" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (totalPages > 1)
        {
            <div class="p-3 border-top d-flex justify-content-between align-items-center">
                <span class="small text-muted">Showing page @currentPage of @totalPages</span>
                <nav aria-label="Audit log pagination">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-userFilter="@currentUserFilter" asp-route-moduleFilter="@currentModuleFilter" asp-route-actionFilter="@currentActionFilter" asp-route-startDate="@startDate" asp-route-endDate="@endDate">Previous</a>
                        </li>
                        @for (int p = 1; p <= totalPages; p++)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-userFilter="@currentUserFilter" asp-route-moduleFilter="@currentModuleFilter" asp-route-actionFilter="@currentActionFilter" asp-route-startDate="@startDate" asp-route-endDate="@endDate">@p</a>
                            </li>
                        }
                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-userFilter="@currentUserFilter" asp-route-moduleFilter="@currentModuleFilter" asp-route-actionFilter="@currentActionFilter" asp-route-startDate="@startDate" asp-route-endDate="@endDate">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
