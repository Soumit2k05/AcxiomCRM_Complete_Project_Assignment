@model AcxiomCRM.Models.Customer
@{
    ViewData["Title"] = Model.CustomerName + " - Details";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-light text-primary border font-monospace">@Model.CustomerCode</span>
                <span class="badge @(Model.Status == "Active" ? "bg-success bg-opacity-10 text-success border border-success" : "bg-secondary")">@Model.Status</span>
            </div>
            <h1 class="h3 fw-bold text-dark mb-0">@Model.CustomerName</h1>
            <p class="text-muted small mb-0">Managed by <strong>@(Model.OwnerId ?? "Unassigned")</strong> &bull; Created on @Model.CreatedDate.ToString("MMMM dd, yyyy")</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-warning btn-sm">
                <i class="bi bi-briefcase me-1"></i> New Opportunity
            </a>
            <a asp-controller="FollowUps" asp-action="Schedule" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-success btn-sm">
                <i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up
            </a>
            <a asp-controller="Activities" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-info btn-sm">
                <i class="bi bi-telephone-plus me-1"></i> Log Activity
            </a>
            <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-primary btn-sm">
                <i class="bi bi-pencil me-1"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- Overview Card -->
        <div class="col-12 col-lg-4">
            <div class="crm-card h-100">
                <div class="crm-card-header">
                    <h5 class="crm-card-title"><i class="bi bi-building text-primary me-2"></i> Company Profile</h5>
                </div>
                <div class="crm-card-body">
                    <div class="mb-3">
                        <div class="text-muted small text-uppercase fw-semibold">Company Name</div>
                        <div class="fw-bold text-dark">@(Model.CompanyName ?? "Individual Account")</div>
                    </div>
                    <div class="mb-3">
                        <div class="text-muted small text-uppercase fw-semibold">Email Address</div>
                        <div><a href="mailto:@Model.Email" class="text-primary text-decoration-none">@Model.Email</a></div>
                    </div>
                    <div class="mb-3">
                        <div class="text-muted small text-uppercase fw-semibold">Phone Number</div>
                        <div class="fw-semibold">@Model.Phone</div>
                    </div>
                    <div class="mb-3">
                        <div class="text-muted small text-uppercase fw-semibold">Address</div>
                        <div class="small text-secondary">
                            @(Model.Address ?? "Not specified")<br />
                            @if (!string.IsNullOrEmpty(Model.City))
                            {
                                <span>@Model.City, @Model.State</span>
                            }
                        </div>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Audit Record</div>
                        <div class="small text-muted">Created by @(Model.CreatedBy ?? "System")</div>
                        @if (Model.ModifiedDate.HasValue)
                        {
                            <div class="small text-muted">Last modified: @Model.ModifiedDate.Value.ToString("yyyy-MM-dd HH:mm")</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Deals & Opportunities Card -->
        <div class="col-12 col-lg-8">
            <div class="crm-card h-100">
                <div class="crm-card-header d-flex justify-content-between align-items-center">
                    <h5 class="crm-card-title"><i class="bi bi-briefcase text-warning me-2"></i> Opportunities (@Model.Opportunities.Count)</h5>
                    <a asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-sm btn-outline-primary">
                        + Add Opportunity
                    </a>
                </div>
                <div class="crm-card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small text-uppercase">
                                <tr>
                                    <th>Deal Name</th>
                                    <th>Stage</th>
                                    <th>Probability</th>
                                    <th class="text-end">Amount</th>
                                    <th>Close Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Opportunities.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted small">No active opportunities associated with this customer.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var opp in Model.Opportunities)
                                    {
                                        <tr>
                                            <td class="fw-semibold">
                                                <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@opp.OpportunityId" class="text-decoration-none text-dark">
                                                    @opp.OpportunityName
                                                </a>
                                            </td>
                                            <td>
                                                <span class="badge @(opp.Stage == "Won" ? "bg-success" : (opp.Stage == "Lost" ? "bg-danger" : "bg-primary"))">
                                                    @opp.Stage
                                                </span>
                                            </td>
                                            <td>@opp.Probability%</td>
                                            <td class="text-end fw-bold">₹@opp.Amount.ToString("N0")</td>
                                            <td class="small text-muted">@opp.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Related Follow-Ups & Activities Row -->
    <div class="row g-4">
        <!-- Follow-Ups -->
        <div class="col-12 col-md-6">
            <div class="crm-card">
                <div class="crm-card-header d-flex justify-content-between align-items-center">
                    <h5 class="crm-card-title"><i class="bi bi-calendar-event text-success me-2"></i> Follow-Ups</h5>
                    <a asp-controller="FollowUps" asp-action="Schedule" asp-route-customerId="@Model.CustomerId" class="btn btn-sm btn-outline-success">
                        + Schedule
                    </a>
                </div>
                <div class="crm-card-body p-0">
                    <ul class="list-group list-group-flush">
                        @if (!Model.FollowUps.Any())
                        {
                            <li class="list-group-item text-center py-3 text-muted small">No follow-ups recorded.</li>
                        }
                        else
                        {
                            @foreach (var f in Model.FollowUps.OrderByDescending(x => x.FollowUpDate))
                            {
                                <li class="list-group-item p-3">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <span class="badge bg-secondary mb-1">@f.FollowUpType</span>
                                            <h6 class="mb-1">@f.Subject</h6>
                                            <div class="small text-muted">@f.Remarks</div>
                                        </div>
                                        <div class="text-end">
                                            <span class="badge @(f.Status == "Completed" ? "bg-success" : "bg-warning text-dark")">@f.Status</span>
                                            <div class="small text-muted mt-1">@f.FollowUpDate.ToString("MMM dd, yyyy")</div>
                                        </div>
                                    </div>
                                </li>
                            }
                        }
                    </ul>
                </div>
            </div>
        </div>

        <!-- Activities Log -->
        <div class="col-12 col-md-6">
            <div class="crm-card">
                <div class="crm-card-header d-flex justify-content-between align-items-center">
                    <h5 class="crm-card-title"><i class="bi bi-clock-history text-info me-2"></i> Interaction Touchpoints</h5>
                    <a asp-controller="Activities" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-sm btn-outline-info">
                        + Log Interaction
                    </a>
                </div>
                <div class="crm-card-body p-0">
                    <ul class="list-group list-group-flush">
                        @if (!Model.Activities.Any())
                        {
                            <li class="list-group-item text-center py-3 text-muted small">No interaction touchpoints logged yet.</li>
                        }
                        else
                        {
                            @foreach (var a in Model.Activities.OrderByDescending(x => x.ActivityDate))
                            {
                                <li class="list-group-item p-3">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <span class="badge bg-info bg-opacity-10 text-info border border-info mb-1">@a.ActivityType</span>
                                            <h6 class="mb-1">@a.Subject</h6>
                                            <p class="small text-muted mb-0">@a.Description</p>
                                        </div>
                                        <div class="small text-muted text-end">
                                            @a.ActivityDate.ToString("yyyy-MM-dd")
                                        </div>
                                    </div>
                                </li>
                            }
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
