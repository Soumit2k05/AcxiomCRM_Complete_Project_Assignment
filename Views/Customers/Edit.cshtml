@model AcxiomCRM.Models.Customer
@{
    ViewData["Title"] = "Edit Customer";
}

<div class="row justify-content-center py-2">
    <div class="col-12 col-lg-8">
        <div class="crm-card">
            <div class="crm-card-header">
                <h4 class="crm-card-title"><i class="bi bi-pencil-square text-primary me-2"></i> Edit Customer</h4>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancel</a>
            </div>
            <div class="crm-card-body p-4">
                <form asp-action="Edit" method="post" id="editCustomerForm">
                    <input type="hidden" asp-for="CustomerId" />
                    <input type="hidden" asp-for="CreatedDate" />
                    <input type="hidden" asp-for="CreatedBy" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="CustomerCode" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="CustomerCode" class="form-control" readonly />
                            <span asp-validation-for="CustomerCode" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label small fw-semibold text-secondary"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CustomerName" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="CustomerName" class="form-control" />
                        <span asp-validation-for="CustomerName" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CompanyName" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="CompanyName" class="form-control" />
                        <span asp-validation-for="CompanyName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="City" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="City" class="form-control" />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="State" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="State" class="form-control" />
                            <span asp-validation-for="State" class="text-danger small"></span>
                        </div>
                    </div>

                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <div class="mb-4">
                            <label asp-for="OwnerId" class="form-label small fw-semibold text-secondary">Assign Sales Executive</label>
                            <select asp-for="OwnerId" class="form-select" asp-items="ViewBag.UsersList">
                                <option value="">Select Assignee</option>
                            </select>
                            <span asp-validation-for="OwnerId" class="text-danger small"></span>
                        </div>
                    }
                    else
                    {
                        <input type="hidden" asp-for="OwnerId" />
                    }

                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                            <i class="bi bi-save me-1"></i> Update Customer
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
