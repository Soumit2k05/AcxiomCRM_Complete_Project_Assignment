@model IEnumerable<AcxiomCRM.Models.Customer>
@{
    ViewData["Title"] = "Customer Management";
    var currentSearch = ViewData["CurrentSearch"] as string;
    var currentStatus = ViewData["CurrentStatus"] as string;
    var currentPage = (int)(ViewData["CurrentPage"] ?? 1);
    var totalPages = (int)(ViewData["TotalPages"] ?? 1);
    var totalItems = (int)(ViewData["TotalItems"] ?? 0);
}

<div class="container-fluid px-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-people-fill text-primary me-2"></i> Customers
            </h1>
            <p class="text-muted mb-0 small">
                Manage master customer accounts, corporate relationships, and assigned sales representatives.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Reports" asp-action="CustomerReport" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-download me-1"></i> Customer Report
            </a>
            <a asp-action="Create" class="btn btn-primary btn-sm shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Add Customer
            </a>
        </div>
    </div>

    <!-- Search & Filter Bar -->
    <div class="crm-card mb-4">
        <div class="crm-card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-12 col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control" placeholder="Search by name, email, phone, company..." value="@currentSearch" />
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <select name="status" class="form-select">
                        <option value="">All Statuses</option>
                        <option value="Active" selected="@(currentStatus == "Active")">Active</option>
                        <option value="Inactive" selected="@(currentStatus == "Inactive")">Inactive</option>
                    </select>
                </div>
                <div class="col-6 col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        <i class="bi bi-funnel me-1"></i> Filter
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Table Card -->
    <div class="crm-card">
        <div class="crm-card-header d-flex justify-content-between align-items-center">
            <div class="crm-card-title">
                Customer Master Records <span class="badge bg-light text-dark border ms-2">@totalItems Total</span>
            </div>
        </div>
        <div class="crm-card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th>Code</th>
                            <th>Customer Name</th>
                            <th>Contact</th>
                            <th>Location</th>
                            <th>Status</th>
                            <th>Owner</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                    No customers found matching the search criteria.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-light text-primary border font-monospace">@item.CustomerCode</span>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.CustomerName</div>
                                        @if (!string.IsNullOrEmpty(item.CompanyName))
                                        {
                                            <div class="small text-muted"><i class="bi bi-building me-1"></i>@item.CompanyName</div>
                                        }
                                    </td>
                                    <td>
                                        <div><a href="mailto:@item.Email" class="text-decoration-none small text-dark"><i class="bi bi-envelope me-1 text-muted"></i>@item.Email</a></div>
                                        <div class="small text-muted"><i class="bi bi-telephone me-1"></i>@item.Phone</div>
                                    </td>
                                    <td class="small text-muted">
                                        @(string.IsNullOrEmpty(item.City) ? "N/A" : $"{item.City}, {item.State}")
                                    </td>
                                    <td>
                                        <span class="badge @(item.Status == "Active" ? "bg-success bg-opacity-10 text-success border border-success" : "bg-secondary bg-opacity-10 text-secondary border border-secondary") badge-status">
                                            @item.Status
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @(item.OwnerId ?? "Unassigned")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@item.CustomerId" class="btn btn-outline-primary" title="Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.CustomerId" class="btn btn-outline-secondary" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                            {
                                                <a asp-action="Delete" asp-route-id="@item.CustomerId" class="btn btn-outline-danger" title="Deactivate">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination Controls -->
        @if (totalPages > 1)
        {
            <div class="p-3 border-top d-flex justify-content-between align-items-center">
                <span class="small text-muted">Showing page @currentPage of @totalPages</span>
                <nav aria-label="Customer pagination">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@currentSearch" asp-route-status="@currentStatus">Previous</a>
                        </li>
                        @for (int p = 1; p <= totalPages; p++)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@currentSearch" asp-route-status="@currentStatus">@p</a>
                            </li>
                        }
                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@currentSearch" asp-route-status="@currentStatus">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
