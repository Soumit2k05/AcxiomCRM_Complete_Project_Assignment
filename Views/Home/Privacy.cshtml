@{
    ViewData["Title"] = "Security & Privacy Policy";
}

<div class="crm-card p-4">
    <h2 class="fw-bold mb-3"><i class="bi bi-shield-check text-success me-2"></i> AcxiomCRM Security &amp; Privacy Policy</h2>
    <p class="text-muted">
        AcxiomCRM implements multi-tiered enterprise data protection standards adhering to strict confidentiality and role-based access governance.
    </p>

    <div class="row g-4 mt-2">
        <div class="col-md-6">
            <div class="p-3 border rounded">
                <h5 class="fw-semibold text-primary"><i class="bi bi-key-fill me-2"></i> Credential Protection</h5>
                <p class="small text-muted mb-0">
                    Passwords are never stored in plaintext and are hashed using adaptive PBKDF2/ASP.NET Core Identity algorithm standards.
                </p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="p-3 border rounded">
                <h5 class="fw-semibold text-info"><i class="bi bi-file-earmark-lock-fill me-2"></i> Anti-Forgery Protection</h5>
                <p class="small text-muted mb-0">
                    State-changing HTTP POST requests are shielded with cryptographically validated anti-forgery tokens (CSRF protection).
                </p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="p-3 border rounded">
                <h5 class="fw-semibold text-warning"><i class="bi bi-clock-history me-2"></i> Audit Logging</h5>
                <p class="small text-muted mb-0">
                    Security events, authentication successes/failures, and business entity modifications are recorded in an append-oriented audit log.
                </p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="p-3 border rounded">
                <h5 class="fw-semibold text-danger"><i class="bi bi-person-slash me-2"></i> Account Lockout</h5>
                <p class="small text-muted mb-0">
                    Accounts are automatically locked after 5 consecutive failed authentication attempts for a duration of 15 minutes to thwart brute-force attacks.
                </p>
            </div>
        </div>
    </div>
</div>
