@model AcxiomCRM.Models.Lead
@{
    ViewData["Title"] = "Convert Lead to Customer";
}

<div class="row justify-content-center py-2">
    <div class="col-12 col-lg-8">
        <div class="crm-card border-success border-opacity-25 shadow-sm">
            <div class="crm-card-header bg-success bg-opacity-10 py-3">
                <h4 class="crm-card-title text-success mb-0">
                    <i class="bi bi-arrow-repeat me-2"></i> Lead-to-Customer Conversion
                </h4>
                <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary btn-sm">Cancel</a>
            </div>
            <div class="crm-card-body p-4">
                <div class="alert alert-info py-2 small mb-4">
                    <i class="bi bi-info-circle-fill me-1"></i> Converting this lead will generate an active Customer profile, finalize the lead state to <strong>Converted</strong>, and optionally generate an Opportunity in the sales pipeline.
                </div>

                <div class="row g-3 mb-4 p-3 bg-light rounded small">
                    <div class="col-md-6">
                        <div class="text-muted">Lead Name:</div>
                        <div class="fw-bold">@Model.LeadName</div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted">Company:</div>
                        <div class="fw-bold">@(Model.CompanyName ?? "N/A")</div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted">Contact:</div>
                        <div>@Model.Email &bull; @Model.Phone</div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted">Assigned Sales Executive:</div>
                        <div class="fw-semibold text-primary">@(Model.AssignedTo ?? "Unassigned")</div>
                    </div>
                </div>

                <form asp-action="ConvertConfirmed" method="post" id="convertLeadForm">
                    <input type="hidden" name="leadId" value="@Model.LeadId" />

                    <div class="form-check form-switch mb-4 p-3 border rounded bg-white">
                        <input class="form-check-input ms-0 me-3" type="checkbox" id="createOpportunityCheck" name="createOpportunity" value="true" checked onchange="toggleOppFields(this.checked)" />
                        <label class="form-check-label fw-bold text-dark" for="createOpportunityCheck">
                            Create Sales Opportunity for this conversion
                        </label>
                        <div class="small text-muted ms-5">Initialize a pipeline deal linked to the new customer record.</div>
                    </div>

                    <div id="oppDetailsBlock">
                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">Opportunity Parameters</h6>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-secondary">Opportunity Name</label>
                            <input type="text" name="opportunityName" class="form-control" value="@ViewBag.DefaultOppName" />
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold text-secondary">Deal Amount (₹)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">₹</span>
                                    <input type="number" step="0.01" min="1" name="opportunityAmount" class="form-control" value="@ViewBag.DefaultAmount" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold text-secondary">Expected Close Date</label>
                                <input type="date" name="expectedCloseDate" class="form-control" value="@ViewBag.DefaultCloseDate" />
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                        <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-success px-4 fw-semibold shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Complete Conversion
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleOppFields(isChecked) {
            document.getElementById('oppDetailsBlock').style.display = isChecked ? 'block' : 'none';
        }
    </script>
}
