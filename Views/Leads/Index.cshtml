@model IEnumerable<AcxiomCRM.Models.Lead>
@{
    ViewData["Title"] = "Lead Management";
    var currentSearch = ViewData["CurrentSearch"] as string;
    var currentStatus = ViewData["CurrentStatus"] as string;
    var currentPriority = ViewData["CurrentPriority"] as string;
    var currentPage = (int)(ViewData["CurrentPage"] ?? 1);
    var totalPages = (int)(ViewData["TotalPages"] ?? 1);
    var totalItems = (int)(ViewData["TotalItems"] ?? 0);
}

<div class="container-fluid px-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-funnel-fill text-info me-2"></i> Leads
            </h1>
            <p class="text-muted mb-0 small">
                Capture prospective buyers, qualify pipeline leads, and convert them to enterprise customers.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Reports" asp-action="ConversionReport" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-pie-chart me-1"></i> Conversion Report
            </a>
            <a asp-action="Create" class="btn btn-primary btn-sm shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Capture Lead
            </a>
        </div>
    </div>

    <!-- Search & Filter Bar -->
    <div class="crm-card mb-4">
        <div class="crm-card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control" placeholder="Search lead name, company, email..." value="@currentSearch" />
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <select name="status" class="form-select">
                        <option value="">All Statuses</option>
                        <option value="New" selected="@(currentStatus == "New")">New</option>
                        <option value="Contacted" selected="@(currentStatus == "Contacted")">Contacted</option>
                        <option value="Qualified" selected="@(currentStatus == "Qualified")">Qualified</option>
                        <option value="Unqualified" selected="@(currentStatus == "Unqualified")">Unqualified</option>
                        <option value="Converted" selected="@(currentStatus == "Converted")">Converted</option>
                        <option value="Lost" selected="@(currentStatus == "Lost")">Lost</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <select name="priority" class="form-select">
                        <option value="">All Priorities</option>
                        <option value="Low" selected="@(currentPriority == "Low")">Low</option>
                        <option value="Medium" selected="@(currentPriority == "Medium")">Medium</option>
                        <option value="High" selected="@(currentPriority == "High")">High</option>
                    </select>
                </div>
                <div class="col-12 col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        <i class="bi bi-funnel me-1"></i> Filter
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Table Card -->
    <div class="crm-card">
        <div class="crm-card-header d-flex justify-content-between align-items-center">
            <div class="crm-card-title">
                Active &amp; Prospective Leads <span class="badge bg-light text-dark border ms-2">@totalItems Total</span>
            </div>
        </div>
        <div class="crm-card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th>Lead Code</th>
                            <th>Lead Name</th>
                            <th>Source</th>
                            <th>Priority</th>
                            <th>Expected Value</th>
                            <th>Status</th>
                            <th>Assigned To</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-funnel fs-2 d-block mb-2 text-secondary"></i>
                                    No leads found matching the filter criteria.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var lead in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-light text-info border font-monospace">@lead.LeadCode</span>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@lead.LeadName</div>
                                        <div class="small text-muted">@(lead.CompanyName ?? lead.Email)</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@lead.Source</span>
                                    </td>
                                    <td>
                                        <span class="badge @(lead.Priority == "High" ? "bg-danger bg-opacity-10 text-danger border border-danger" : (lead.Priority == "Medium" ? "bg-warning bg-opacity-10 text-dark border border-warning" : "bg-light text-secondary border"))">
                                            @lead.Priority
                                        </span>
                                    </td>
                                    <td class="fw-semibold">
                                        ₹@lead.ExpectedValue.ToString("N0")
                                    </td>
                                    <td>
                                        @{
                                            var badgeClass = lead.Status switch
                                            {
                                                "New" => "bg-primary bg-opacity-10 text-primary border border-primary",
                                                "Contacted" => "bg-info bg-opacity-10 text-info border border-info",
                                                "Qualified" => "bg-success bg-opacity-10 text-success border border-success",
                                                "Converted" => "bg-purple text-white",
                                                "Lost" => "bg-danger bg-opacity-10 text-danger border border-danger",
                                                _ => "bg-secondary bg-opacity-10 text-secondary border border-secondary"
                                            };
                                        }
                                        <span class="badge @badgeClass badge-status">@lead.Status</span>
                                    </td>
                                    <td class="small text-muted">
                                        @(lead.AssignedTo ?? "Unassigned")
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@lead.LeadId" class="btn btn-outline-primary" title="Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (lead.Status != "Converted")
                                            {
                                                <a asp-action="Convert" asp-route-id="@lead.LeadId" class="btn btn-outline-success" title="Convert to Customer & Deal">
                                                    <i class="bi bi-arrow-repeat"></i> Convert
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@lead.LeadId" class="btn btn-outline-secondary" title="Edit">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                            }
                                            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                            {
                                                <a asp-action="Delete" asp-route-id="@lead.LeadId" class="btn btn-outline-danger" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (totalPages > 1)
        {
            <div class="p-3 border-top d-flex justify-content-between align-items-center">
                <span class="small text-muted">Showing page @currentPage of @totalPages</span>
                <nav aria-label="Lead pagination">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@currentSearch" asp-route-status="@currentStatus">Previous</a>
                        </li>
                        @for (int p = 1; p <= totalPages; p++)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@currentSearch" asp-route-status="@currentStatus">@p</a>
                            </li>
                        }
                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@currentSearch" asp-route-status="@currentStatus">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
