@model AcxiomCRM.Models.Opportunity
@{
    ViewData["Title"] = "Delete Opportunity";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-7 col-lg-6">
        <div class="crm-card border-danger border-opacity-25 shadow-sm">
            <div class="crm-card-header bg-danger bg-opacity-10 py-3 text-danger">
                <h5 class="crm-card-title text-danger mb-0">
                    <i class="bi bi-trash-fill me-2"></i> Confirm Opportunity Deletion
                </h5>
            </div>
            <div class="crm-card-body p-4">
                <p class="text-secondary">
                    Are you sure you want to permanently delete opportunity <strong>@Model.OpportunityName</strong>?
                    This action will be recorded in the security audit trail.
                </p>

                <div class="p-3 bg-light rounded mb-4 small">
                    <div class="row g-2">
                        <div class="col-4 text-muted">Amount:</div>
                        <div class="col-8 fw-semibold">₹@Model.Amount.ToString("N0")</div>
                        <div class="col-4 text-muted">Stage:</div>
                        <div class="col-8 fw-semibold">@Model.Stage</div>
                        <div class="col-4 text-muted">Probability:</div>
                        <div class="col-8 fw-semibold">@Model.Probability%</div>
                    </div>
                </div>

                <form asp-action="Delete" method="post" id="deleteOppForm">
                    <input type="hidden" asp-for="OpportunityId" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">Cancel</a>
                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold shadow-sm">
                            <i class="bi bi-trash me-1"></i> Yes, Delete Deal
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
