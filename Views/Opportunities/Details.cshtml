@model AcxiomCRM.Models.Opportunity
@{
    ViewData["Title"] = Model.OpportunityName + " - Details";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge rounded-pill @(Model.Stage == "Won" ? "bg-success" : (Model.Stage == "Lost" ? "bg-danger" : "bg-primary"))">@Model.Stage</span>
                <span class="badge rounded-pill bg-light text-dark border">@Model.Status</span>
            </div>
            <h1 class="h3 fw-bold text-dark mb-0">@Model.OpportunityName</h1>
            <p class="text-muted small mb-0">Assigned: <strong>@(Model.AssignedTo ?? "Unassigned")</strong> &bull; Expected Close: @Model.ExpectedCloseDate.ToString("MMMM dd, yyyy")</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.OpportunityId" class="btn btn-primary rounded-pill btn-sm px-3 shadow-sm">
                <i class="bi bi-pencil me-1"></i> Edit Deal
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm px-3">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-6">
            <div class="crm-card h-100">
                <div class="crm-card-header">
                    <h5 class="crm-card-title"><i class="bi bi-cash-coin text-success me-2"></i> Financial Valuation</h5>
                </div>
                <div class="crm-card-body">
                    <div class="mb-4">
                        <div class="text-muted small text-uppercase fw-semibold">Contract Amount</div>
                        <div class="display-6 fw-bold text-dark mb-0">₹@Model.Amount.ToString("N0")</div>
                    </div>
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted small text-uppercase fw-semibold">Closure Probability</span>
                            <span class="fw-bold text-primary">@Model.Probability%</span>
                        </div>
                        <div class="progress rounded-pill" style="height: 10px;">
                            <div class="progress-bar bg-primary rounded-pill" style="width: @Model.Probability%"></div>
                        </div>
                    </div>
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="text-muted small text-uppercase fw-semibold">Calculated Weighted Pipeline</div>
                        <div class="h4 fw-bold text-primary mb-0">₹@Model.WeightedPipeline.ToString("N0")</div>
                        <div class="small text-muted mt-1">(Amount × Probability / 100)</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="crm-card h-100">
                <div class="crm-card-header">
                    <h5 class="crm-card-title"><i class="bi bi-info-circle text-info me-2"></i> Deal Context &amp; Linkage</h5>
                </div>
                <div class="crm-card-body">
                    <div class="mb-3">
                        <div class="text-muted small text-uppercase fw-semibold">Associated Customer</div>
                        @if (Model.Customer != null)
                        {
                            <div>
                                <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId" class="fw-bold text-primary text-decoration-none">
                                    <i class="bi bi-building me-1"></i>@Model.Customer.CustomerName
                                </a>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">None</span>
                        }
                    </div>

                    <div class="mb-3">
                        <div class="text-muted small text-uppercase fw-semibold">Associated Lead</div>
                        @if (Model.Lead != null)
                        {
                            <div>
                                <a asp-controller="Leads" asp-action="Details" asp-route-id="@Model.LeadId" class="fw-bold text-info text-decoration-none">
                                    <i class="bi bi-funnel me-1"></i>@Model.Lead.LeadName
                                </a>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">None</span>
                        }
                    </div>

                    <div class="mb-3">
                        <div class="text-muted small text-uppercase fw-semibold">Internal Notes</div>
                        <p class="small text-secondary mb-0">@(string.IsNullOrEmpty(Model.Notes) ? "No notes recorded." : Model.Notes)</p>
                    </div>

                    <div class="small text-muted border-top pt-3">
                        Created on @Model.CreatedDate.ToString("yyyy-MM-dd HH:mm")
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
