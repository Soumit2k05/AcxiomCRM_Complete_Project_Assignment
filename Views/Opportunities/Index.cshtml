@model IEnumerable<AcxiomCRM.Models.Opportunity>
@{
    ViewData["Title"] = "Opportunities";
    var currentSearch = ViewData["CurrentSearch"] as string;
    var currentStage = ViewData["CurrentStage"] as string;
    var currentStatus = ViewData["CurrentStatus"] as string;
    var currentPage = (int)(ViewData["CurrentPage"] ?? 1);
    var totalPages = (int)(ViewData["TotalPages"] ?? 1);
    var totalItems = (int)(ViewData["TotalItems"] ?? 0);
}

<div class="container-fluid px-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-briefcase-fill text-warning me-2"></i> Opportunities
            </h1>
            <p class="text-muted mb-0 small">
                Track sales pipeline stages, contract amounts, closure probabilities, and derived weighted revenue.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Pipeline" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-kanban me-1"></i> Visual Pipeline
            </a>
            <a asp-controller="Reports" asp-action="PipelineReport" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-file-earmark-bar-graph me-1"></i> Pipeline Report
            </a>
            <a asp-action="Create" class="btn btn-primary btn-sm shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> New Opportunity
            </a>
        </div>
    </div>

    <!-- Search & Filter Bar -->
    <div class="crm-card mb-4">
        <div class="crm-card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control" placeholder="Search opportunity or customer..." value="@currentSearch" />
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <select name="stage" class="form-select">
                        <option value="">All Stages</option>
                        <option value="Qualification" selected="@(currentStage == "Qualification")">Qualification</option>
                        <option value="Proposal" selected="@(currentStage == "Proposal")">Proposal</option>
                        <option value="Negotiation" selected="@(currentStage == "Negotiation")">Negotiation</option>
                        <option value="Won" selected="@(currentStage == "Won")">Won</option>
                        <option value="Lost" selected="@(currentStage == "Lost")">Lost</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <select name="status" class="form-select">
                        <option value="">All Statuses</option>
                        <option value="Open" selected="@(currentStatus == "Open")">Open</option>
                        <option value="Won" selected="@(currentStatus == "Won")">Won</option>
                        <option value="Lost" selected="@(currentStatus == "Lost")">Lost</option>
                    </select>
                </div>
                <div class="col-12 col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        <i class="bi bi-funnel me-1"></i> Filter
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Opportunities Table -->
    <div class="crm-card">
        <div class="crm-card-header d-flex justify-content-between align-items-center">
            <div class="crm-card-title">
                Sales Pipeline Opportunities <span class="badge bg-light text-dark border ms-2">@totalItems Total</span>
            </div>
        </div>
        <div class="crm-card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th>Opportunity</th>
                            <th>Customer / Lead</th>
                            <th>Stage</th>
                            <th>Probability</th>
                            <th class="text-end">Amount</th>
                            <th class="text-end">Weighted</th>
                            <th>Close Date</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-briefcase fs-2 d-block mb-2 text-secondary"></i>
                                    No opportunities found matching the filter criteria.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">@item.OpportunityName</div>
                                        <div class="small text-muted">Assigned to: @(item.AssignedTo ?? "Unassigned")</div>
                                    </td>
                                    <td>
                                        @if (item.Customer != null)
                                        {
                                            <a asp-controller="Customers" asp-action="Details" asp-route-id="@item.CustomerId" class="text-decoration-none small text-dark fw-semibold">
                                                <i class="bi bi-building me-1 text-primary"></i>@item.Customer.CustomerName
                                            </a>
                                        }
                                        else if (item.Lead != null)
                                        {
                                            <a asp-controller="Leads" asp-action="Details" asp-route-id="@item.LeadId" class="text-decoration-none small text-secondary">
                                                <i class="bi bi-funnel me-1 text-info"></i>@item.Lead.LeadName
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @(item.Stage == "Won" ? "bg-success" : (item.Stage == "Lost" ? "bg-danger" : (item.Stage == "Negotiation" ? "bg-warning text-dark" : "bg-primary"))) badge-status">
                                            @item.Stage
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2" style="width: 100px;">
                                            <span class="small fw-semibold">@item.Probability%</span>
                                            <div class="progress flex-grow-1" style="height: 6px;">
                                                <div class="progress-bar bg-primary" role="progressbar" style="width: @item.Probability%"></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-end fw-bold text-dark">
                                        ₹@item.Amount.ToString("N0")
                                    </td>
                                    <td class="text-end small fw-semibold text-primary">
                                        ₹@item.WeightedPipeline.ToString("N0")
                                    </td>
                                    <td class="small text-muted">
                                        @item.ExpectedCloseDate.ToString("yyyy-MM-dd")
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@item.OpportunityId" class="btn btn-outline-primary" title="Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.OpportunityId" class="btn btn-outline-secondary" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                            {
                                                <a asp-action="Delete" asp-route-id="@item.OpportunityId" class="btn btn-outline-danger" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (totalPages > 1)
        {
            <div class="p-3 border-top d-flex justify-content-between align-items-center">
                <span class="small text-muted">Showing page @currentPage of @totalPages</span>
                <nav aria-label="Opportunity pagination">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@currentSearch" asp-route-stage="@currentStage">Previous</a>
                        </li>
                        @for (int p = 1; p <= totalPages; p++)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@currentSearch" asp-route-stage="@currentStage">@p</a>
                            </li>
                        }
                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@currentSearch" asp-route-stage="@currentStage">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
