@model IEnumerable<AcxiomCRM.Models.Opportunity>
@{
    ViewData["Title"] = "Sales Pipeline Board";
    var stages = new[] { "Qualification", "Proposal", "Negotiation", "Won", "Lost" };
}

<div class="container-fluid px-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-kanban text-primary me-2"></i> Visual Sales Pipeline
            </h1>
            <p class="text-muted mb-0 small">
                Stage progression of active deals from initial qualification to closed revenue.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm px-3">
                <i class="bi bi-list-ul me-1"></i> List View
            </a>
            <a asp-action="Create" class="btn btn-primary rounded-pill btn-sm px-3 shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> New Opportunity
            </a>
        </div>
    </div>

    <!-- Visual Pipeline Columns -->
    <div class="row g-3">
        @foreach (var stage in stages)
        {
            var stageDeals = Model.Where(o => o.Stage == stage).ToList();
            var totalStageAmount = stageDeals.Sum(o => o.Amount);

            <div class="col-12 col-md-6 col-lg" style="min-width: 240px;">
                <div class="p-3 bg-white rounded-4 border shadow-sm h-100 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                        <span class="fw-bold small text-uppercase text-secondary">@stage</span>
                        <span class="badge rounded-pill bg-light text-dark border">@stageDeals.Count</span>
                    </div>
                    <div class="small fw-bold text-primary mb-3">
                        ₹@totalStageAmount.ToString("N0")
                    </div>

                    <div class="d-flex flex-column gap-2 flex-grow-1">
                        @if (!stageDeals.Any())
                        {
                            <div class="text-center py-4 text-muted small fst-italic">No deals in stage</div>
                        }
                        else
                        {
                            @foreach (var opp in stageDeals)
                            {
                                <div class="p-3 rounded-3 border bg-light bg-opacity-50 hover-shadow transition-all">
                                    <div class="fw-bold text-dark small mb-1">
                                        <a asp-action="Details" asp-route-id="@opp.OpportunityId" class="text-decoration-none text-dark">
                                            @opp.OpportunityName
                                        </a>
                                    </div>
                                    <div class="text-muted" style="font-size: 0.75rem;">
                                        @(opp.Customer?.CustomerName ?? "Prospect")
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                                        <span class="fw-bold text-primary small">₹@opp.Amount.ToString("N0")</span>
                                        <span class="badge rounded-pill bg-light text-secondary border" style="font-size: 0.7rem;">@opp.Probability%</span>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
