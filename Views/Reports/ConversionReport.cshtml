@model IEnumerable<AcxiomCRM.Models.Lead>
@{
    ViewData["Title"] = "Lead Conversion Report";
    var totalLeads = Model.Count();
    var convertedLeads = Model.Count(l => l.Status == "Converted");
    var conversionRate = totalLeads > 0 ? Math.Round((double)convertedLeads / totalLeads * 100, 1) : 0;
}

<div class="container-fluid px-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-funnel-fill text-info me-2"></i> Lead Conversion Analytics
            </h1>
            <p class="text-muted mb-0 small">
                Track marketing channel effectiveness and lead-to-customer conversion ratios.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ConversionReport" asp-route-export="csv" class="btn btn-outline-success rounded-pill btn-sm px-3">
                <i class="bi bi-file-earmark-excel me-1"></i> Export to CSV
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm px-3">
                <i class="bi bi-arrow-left me-1"></i> Hub
            </a>
        </div>
    </div>

    <!-- Conversion KPIs -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="kpi-card">
                <div class="kpi-label">Total Leads Captured</div>
                <div class="kpi-value text-dark">@totalLeads</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="kpi-card">
                <div class="kpi-label">Successfully Converted</div>
                <div class="kpi-value text-success">@convertedLeads</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="kpi-card border-success border-opacity-25 bg-light">
                <div class="kpi-label text-success">Conversion Rate</div>
                <div class="kpi-value text-success">@conversionRate%</div>
            </div>
        </div>
    </div>

    <div class="crm-card">
        <div class="crm-card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th>Code</th>
                            <th>Lead Name</th>
                            <th>Source</th>
                            <th>Status</th>
                            <th>Expected Value</th>
                            <th>Converted Customer</th>
                            <th>Assigned To</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model)
                        {
                            <tr>
                                <td><span class="badge bg-light text-info border font-monospace">@l.LeadCode</span></td>
                                <td class="fw-bold">@l.LeadName</td>
                                <td><span class="badge rounded-pill bg-light text-dark border">@l.Source</span></td>
                                <td><span class="badge rounded-pill @(l.Status == "Converted" ? "bg-purple text-white" : "bg-secondary")">@l.Status</span></td>
                                <td class="fw-semibold">₹@l.ExpectedValue.ToString("N0")</td>
                                <td>
                                    @if (l.ConvertedCustomer != null)
                                    {
                                        <span class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i>@l.ConvertedCustomer.CustomerName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td class="small text-muted">@(l.AssignedTo ?? "Unassigned")</td>
                                <td class="small text-muted">@l.CreatedDate.ToString("yyyy-MM-dd")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
