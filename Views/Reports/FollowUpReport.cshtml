@model IEnumerable<AcxiomCRM.Models.FollowUp>
@{
    ViewData["Title"] = "Follow-Up Report";
    var total = Model.Count();
    var completed = Model.Count(f => f.Status == "Completed");
    var planned = Model.Count(f => f.Status == "Planned");
    var overdue = Model.Count(f => f.Status == "Planned" && f.FollowUpDate < DateTime.UtcNow);
}

<div class="container-fluid px-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-calendar-check-fill text-success me-2"></i> Follow-Up Compliance Report
            </h1>
            <p class="text-muted mb-0 small">
                Sales engagement activities, overdue milestones, and completed meetings.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="FollowUpReport" asp-route-export="csv" class="btn btn-outline-success rounded-pill btn-sm px-3">
                <i class="bi bi-file-earmark-excel me-1"></i> Export to CSV
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm px-3">
                <i class="bi bi-arrow-left me-1"></i> Hub
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="kpi-card">
                <div class="kpi-label">Total Activities</div>
                <div class="kpi-value">@total</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-card">
                <div class="kpi-label">Completed</div>
                <div class="kpi-value text-success">@completed</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-card">
                <div class="kpi-label">Planned</div>
                <div class="kpi-value text-primary">@planned</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-card border-danger border-opacity-25 bg-light">
                <div class="kpi-label text-danger">Overdue</div>
                <div class="kpi-value text-danger">@overdue</div>
            </div>
        </div>
    </div>

    <div class="crm-card">
        <div class="crm-card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th>Type</th>
                            <th>Subject</th>
                            <th>Target Contact</th>
                            <th>Follow-Up Date</th>
                            <th>Status</th>
                            <th>Assignee</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model)
                        {
                            <tr>
                                <td><span class="badge rounded-pill bg-light text-dark border">@f.FollowUpType</span></td>
                                <td class="fw-bold">@f.Subject</td>
                                <td class="small">@(f.Customer?.CustomerName ?? f.Lead?.LeadName ?? "-")</td>
                                <td class="small text-muted">@f.FollowUpDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td><span class="badge rounded-pill @(f.Status == "Completed" ? "bg-success" : (f.FollowUpDate < DateTime.UtcNow ? "bg-danger" : "bg-warning text-dark"))">@f.Status</span></td>
                                <td class="small text-muted">@(f.AssignedTo ?? "Unassigned")</td>
                                <td class="small text-muted text-truncate" style="max-width: 250px;">@(f.Remarks ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
