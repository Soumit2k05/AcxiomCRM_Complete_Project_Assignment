@{
    ViewData["Title"] = "Reports & Analytics Hub";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-graph-up-arrow text-primary me-2"></i> Reports &amp; Analytics Hub
            </h1>
            <p class="text-muted mb-0 small">
                Executive business intelligence, sales conversion analytics, follow-up metrics, and audit exports.
            </p>
        </div>
        <div>
            <span class="badge rounded-pill bg-light text-dark border px-3 py-2">
                <i class="bi bi-file-earmark-spreadsheet text-success me-1"></i> CSV Export Available on All Reports
            </span>
        </div>
    </div>

    <!-- Reports Grid -->
    <div class="row g-4">
        <!-- 1. Pipeline Report -->
        <div class="col-12 col-md-6 col-lg-4">
            <div class="crm-card h-100 p-4 d-flex flex-column justify-content-between">
                <div>
                    <div class="kpi-icon bg-warning bg-opacity-10 text-warning mb-3">
                        <i class="bi bi-bar-chart-line-fill"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">Pipeline &amp; Revenue Report</h5>
                    <p class="small text-muted mb-3">
                        Stage-wise and owner-wise deal value, closure probabilities, and derived weighted revenue projections.
                    </p>
                </div>
                <div class="d-flex gap-2 pt-3 border-top">
                    <a asp-action="PipelineReport" class="btn btn-outline-primary rounded-pill btn-sm flex-grow-1">View Report</a>
                    <a asp-action="PipelineReport" asp-route-export="csv" class="btn btn-light rounded-pill btn-sm border" title="Export CSV"><i class="bi bi-download"></i></a>
                </div>
            </div>
        </div>

        <!-- 2. Customer Report -->
        <div class="col-12 col-md-6 col-lg-4">
            <div class="crm-card h-100 p-4 d-flex flex-column justify-content-between">
                <div>
                    <div class="kpi-icon bg-primary bg-opacity-10 text-primary mb-3">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">Customer Master Report</h5>
                    <p class="small text-muted mb-3">
                        Comprehensive customer account ledger, lifecycle status, geographical demographics, and assigned account executives.
                    </p>
                </div>
                <div class="d-flex gap-2 pt-3 border-top">
                    <a asp-action="CustomerReport" class="btn btn-outline-primary rounded-pill btn-sm flex-grow-1">View Report</a>
                    <a asp-action="CustomerReport" asp-route-export="csv" class="btn btn-light rounded-pill btn-sm border" title="Export CSV"><i class="bi bi-download"></i></a>
                </div>
            </div>
        </div>

        <!-- 3. Lead Conversion Report -->
        <div class="col-12 col-md-6 col-lg-4">
            <div class="crm-card h-100 p-4 d-flex flex-column justify-content-between">
                <div>
                    <div class="kpi-icon bg-info bg-opacity-10 text-info mb-3">
                        <i class="bi bi-funnel-fill"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">Lead Conversion Report</h5>
                    <p class="small text-muted mb-3">
                        Inbound lead source distribution, qualification conversion rates, and customer acquisition outcomes.
                    </p>
                </div>
                <div class="d-flex gap-2 pt-3 border-top">
                    <a asp-action="ConversionReport" class="btn btn-outline-primary rounded-pill btn-sm flex-grow-1">View Report</a>
                    <a asp-action="ConversionReport" asp-route-export="csv" class="btn btn-light rounded-pill btn-sm border" title="Export CSV"><i class="bi bi-download"></i></a>
                </div>
            </div>
        </div>

        <!-- 4. Follow-Up Activity Report -->
        <div class="col-12 col-md-6 col-lg-4">
            <div class="crm-card h-100 p-4 d-flex flex-column justify-content-between">
                <div>
                    <div class="kpi-icon bg-success bg-opacity-10 text-success mb-3">
                        <i class="bi bi-calendar-check-fill"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">Follow-Up Compliance Report</h5>
                    <p class="small text-muted mb-3">
                        Planned, completed, rescheduled, and overdue activities tracking sales outreach adherence.
                    </p>
                </div>
                <div class="d-flex gap-2 pt-3 border-top">
                    <a asp-action="FollowUpReport" class="btn btn-outline-primary rounded-pill btn-sm flex-grow-1">View Report</a>
                    <a asp-action="FollowUpReport" asp-route-export="csv" class="btn btn-light rounded-pill btn-sm border" title="Export CSV"><i class="bi bi-download"></i></a>
                </div>
            </div>
        </div>

        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
            <!-- 5. User Activity Report -->
            <div class="col-12 col-md-6 col-lg-4">
                <div class="crm-card h-100 p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="kpi-icon bg-danger bg-opacity-10 text-danger mb-3">
                            <i class="bi bi-activity"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-1">Sales Activity Ledger</h5>
                        <p class="small text-muted mb-3">
                            Aggregated volume of customer calls, meetings, emails, and touchpoints logged by sales team members.
                        </p>
                    </div>
                    <div class="d-flex gap-2 pt-3 border-top">
                        <a asp-action="UserActivityReport" class="btn btn-outline-primary rounded-pill btn-sm flex-grow-1">View Report</a>
                        <a asp-action="UserActivityReport" asp-route-export="csv" class="btn btn-light rounded-pill btn-sm border" title="Export CSV"><i class="bi bi-download"></i></a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
