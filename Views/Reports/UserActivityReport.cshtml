@model IEnumerable<AcxiomCRM.Models.Activity>
@{
    ViewData["Title"] = "User Activity Report";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-activity text-danger me-2"></i> Sales Activity Ledger
            </h1>
            <p class="text-muted mb-0 small">
                Audit of direct communications, client meetings, calls, and tasks logged by team members.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="UserActivityReport" asp-route-export="csv" class="btn btn-outline-success rounded-pill btn-sm px-3">
                <i class="bi bi-file-earmark-excel me-1"></i> Export to CSV
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm px-3">
                <i class="bi bi-arrow-left me-1"></i> Hub
            </a>
        </div>
    </div>

    <div class="crm-card">
        <div class="crm-card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th>Type</th>
                            <th>Subject</th>
                            <th>Target Contact</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Logged By</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model)
                        {
                            <tr>
                                <td><span class="badge rounded-pill bg-light text-dark border">@a.ActivityType</span></td>
                                <td class="fw-bold">@a.Subject</td>
                                <td class="small">@(a.Customer?.CustomerName ?? a.Lead?.LeadName ?? "-")</td>
                                <td class="small text-muted">@a.ActivityDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td><span class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success">@a.Status</span></td>
                                <td class="small text-muted">@(a.AssignedTo ?? "System")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
