@using Microsoft.AspNetCore.Identity
@using AcxiomCRM.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var displayName = currentUser?.FullName ?? User.Identity?.Name ?? "User";
    var userRole = User.IsInRole("Admin") ? "Admin" : (User.IsInRole("Manager") ? "Manager" : "Sales Executive");

    <div class="d-flex align-items-center gap-3">
        <div class="text-end d-none d-sm-block">
            <div class="fw-semibold text-dark small">@displayName</div>
            <span class="badge @(userRole == "Admin" ? "bg-danger" : (userRole == "Manager" ? "bg-primary" : "bg-success"))" style="font-size: 0.7rem;">
                @userRole
            </span>
        </div>
        <div class="dropdown">
            <div class="ig-avatar-ring cursor-pointer" id="userMenuButton" data-bs-toggle="dropdown" aria-expanded="false" style="cursor: pointer;">
                <div class="ig-avatar-inner">
                    <div class="rounded-circle bg-light text-dark d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                        <i class="bi bi-person-fill fs-5"></i>
                    </div>
                </div>
            </div>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="userMenuButton">
                <li class="px-3 py-2 border-bottom">
                    <div class="fw-bold">@displayName</div>
                    <div class="text-muted small">@User.Identity?.Name</div>
                </li>
                <li>
                    <a class="dropdown-item py-2" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-speedometer2 me-2"></i> Dashboard
                    </a>
                </li>
                <li>
                    <a class="dropdown-item py-2" href="/api/customers" target="_blank">
                        <i class="bi bi-code-slash me-2"></i> REST API (/api/customers)
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm" class="d-inline">
                        <button type="submit" class="dropdown-item py-2 text-danger">
                            <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
}
else
{
    <div class="d-flex align-items-center gap-2">
        <a class="btn btn-outline-dark btn-sm px-3 rounded-pill" asp-controller="Account" asp-action="Login">
            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
        </a>
        <a class="btn btn-primary btn-sm px-3 rounded-pill" asp-controller="Account" asp-action="Register">
            <i class="bi bi-person-plus me-1"></i> Register
        </a>
    </div>
}
