@model AcxiomCRM.ViewModels.UserCreateViewModel
@{
    ViewData["Title"] = "Create User";
}

<div class="row justify-content-center py-2">
    <div class="col-12 col-lg-7">
        <div class="crm-card">
            <div class="crm-card-header">
                <h4 class="crm-card-title"><i class="bi bi-person-plus text-primary me-2"></i> Create User Account</h4>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm">Cancel</a>
            </div>
            <div class="crm-card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="FullName" class="form-control" placeholder="Full name" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="Email" class="form-control" placeholder="user@acxiomcrm.local" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Role" class="form-label small fw-semibold text-secondary"></label>
                        <select asp-for="Role" class="form-select">
                            <option value="SalesExecutive">Sales Executive</option>
                            <option value="Manager">Manager</option>
                            <option value="Admin">Admin</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" />
                        <div class="small text-muted mt-1">Minimum 8 characters with digits, uppercase, and symbols.</div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">Cancel</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                            <i class="bi bi-check-lg me-1"></i> Create Account
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
