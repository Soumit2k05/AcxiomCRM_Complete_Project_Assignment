@model AcxiomCRM.ViewModels.UserEditViewModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="row justify-content-center py-2">
    <div class="col-12 col-lg-7">
        <div class="crm-card">
            <div class="crm-card-header">
                <h4 class="crm-card-title"><i class="bi bi-pencil-square text-primary me-2"></i> Edit User Account</h4>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm">Cancel</a>
            </div>
            <div class="crm-card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Role" class="form-label small fw-semibold text-secondary"></label>
                        <select asp-for="Role" class="form-select">
                            <option value="SalesExecutive">Sales Executive</option>
                            <option value="Manager">Manager</option>
                            <option value="Admin">Admin</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold text-dark"></label>
                        <div class="small text-muted">Deactivated users are blocked from logging in.</div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">Cancel</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                            <i class="bi bi-save me-1"></i> Update User
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
