@model IEnumerable<AcxiomCRM.ViewModels.UserItemViewModel>
@{
    ViewData["Title"] = "User & Role Administration";
    var currentSearch = ViewData["CurrentSearch"] as string;
}

<div class="container-fluid px-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-shield-lock-fill text-danger me-2"></i> User &amp; Role Management
            </h1>
            <p class="text-muted mb-0 small">
                Administer user accounts, assign primary roles (Admin, Manager, Sales Executive), manage lockout states, and trigger secure password resets.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary rounded-pill btn-sm px-3 shadow-sm">
                <i class="bi bi-person-plus me-1"></i> Add User
            </a>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="crm-card mb-4">
        <div class="crm-card-body p-3">
            <form method="get" asp-action="Index" class="d-flex gap-2">
                <input type="text" name="search" class="form-control rounded-pill px-3" placeholder="Search by user name or email..." value="@currentSearch" style="max-width: 400px;" />
                <button type="submit" class="btn btn-primary rounded-pill btn-sm px-4">Search</button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm px-3">Reset</a>
            </form>
        </div>
    </div>

    <!-- Users Table -->
    <div class="crm-card">
        <div class="crm-card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th>User</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Lockout Status</th>
                            <th>Failed Attempts</th>
                            <th>Created Date</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@user.FullName</div>
                                    <div class="small text-muted"><i class="bi bi-envelope me-1"></i>@user.Email</div>
                                </td>
                                <td>
                                    <span class="badge rounded-pill @(user.Role == "Admin" ? "bg-danger" : (user.Role == "Manager" ? "bg-primary" : "bg-success"))">
                                        @user.Role
                                    </span>
                                </td>
                                <td>
                                    <span class="badge rounded-pill @(user.IsActive ? "bg-success bg-opacity-10 text-success border border-success" : "bg-secondary bg-opacity-10 text-secondary border border-secondary")">
                                        @(user.IsActive ? "Active" : "Deactivated")
                                    </span>
                                </td>
                                <td>
                                    @if (user.IsLockedOut)
                                    {
                                        <span class="badge rounded-pill bg-danger">Locked Out</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-light text-muted border">Normal</span>
                                    }
                                </td>
                                <td>
                                    <span class="small @(user.AccessFailedCount > 0 ? "text-warning fw-bold" : "text-muted")">
                                        @user.AccessFailedCount / 5
                                    </span>
                                </td>
                                <td class="small text-muted">
                                    @user.CreatedDate.ToString("yyyy-MM-dd")
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-secondary btn-sm rounded-pill" title="Edit Profile">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="ResetPassword" asp-route-id="@user.Id" class="btn btn-outline-warning btn-sm rounded-pill" title="Reset Password">
                                            <i class="bi bi-key"></i>
                                        </a>
                                        @if (user.IsLockedOut)
                                        {
                                            <form asp-action="Unlock" asp-route-id="@user.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-outline-success btn-sm rounded-pill" title="Unlock Account">
                                                    <i class="bi bi-unlock"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
