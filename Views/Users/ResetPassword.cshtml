@model AcxiomCRM.ViewModels.UserResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-7 col-lg-6">
        <div class="crm-card border-warning border-opacity-25 shadow-sm">
            <div class="crm-card-header bg-warning bg-opacity-10 py-3">
                <h5 class="crm-card-title text-dark mb-0">
                    <i class="bi bi-key-fill text-warning me-2"></i> Reset User Password
                </h5>
            </div>
            <div class="crm-card-body p-4">
                <p class="text-secondary small mb-3">
                    Set a new temporary password for <strong>@Model.FullName</strong> (<code>@Model.Email</code>). Passwords are securely hashed by ASP.NET Core Identity.
                </p>

                <form asp-action="ResetPassword" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="FullName" />
                    <input type="hidden" asp-for="Email" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-4">
                        <label asp-for="NewPassword" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="NewPassword" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">Cancel</a>
                        <button type="submit" class="btn btn-warning rounded-pill px-4 fw-semibold shadow-sm">
                            <i class="bi bi-shield-check me-1"></i> Update Password
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
